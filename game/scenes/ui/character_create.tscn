[gd_scene load_steps=2 format=3 uid="uid://charcreate"]

[ext_resource type="Script" path="res://scenes/ui/character_create.gd" id="1"]

[node name="CharacterCreate" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.07, 0.07, 0.12, 1)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -280.0
offset_right = 220.0
offset_bottom = 280.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/VBox"]
text = "Create Your Character"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22

[node name="NameLabel" type="Label" parent="Panel/VBox"]
text = "Character Name"

[node name="NameInput" type="LineEdit" parent="Panel/VBox"]
placeholder_text = "Enter name…"
custom_minimum_size = Vector2(400, 40)
max_length = 20

[node name="TypeLabel" type="Label" parent="Panel/VBox"]
text = "Pick your starter type:"

[node name="TypeGrid" type="GridContainer" parent="Panel/VBox"]
columns = 4
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="PreviewLabel" type="Label" parent="Panel/VBox"]
custom_minimum_size = Vector2(400, 50)
autowrap_mode = 3

[node name="ConfirmBtn" type="Button" parent="Panel/VBox"]
text = "Begin Adventure"
custom_minimum_size = Vector2(400, 44)

[node name="ErrorLabel" type="Label" parent="Panel/VBox"]
modulate = Color(1, 0.3, 0.3, 1)
autowrap_mode = 3

[connection signal="pressed" from="Panel/VBox/ConfirmBtn" to="." method="_on_confirm_btn_pressed"]
