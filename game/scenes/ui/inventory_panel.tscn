[gd_scene load_steps=2 format=3 uid="uid://invpanel"]

[ext_resource type="Script" path="res://scenes/ui/inventory_panel.gd" id="1"]

[node name="InventoryPanel" type="PanelContainer"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -250.0
offset_right = 200.0
offset_bottom = 250.0
mouse_filter = 0
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox"]
text = "🎒 Inventory"
theme_override_font_sizes/font_size = 18

[node name="CoinsLabel" type="Label" parent="Margin/VBox"]
text = "Coins: 0"

[node name="Separator" type="HSeparator" parent="Margin/VBox"]

[node name="ItemList" type="VBoxContainer" parent="Margin/VBox"]
custom_minimum_size = Vector2(360, 180)

[node name="CloseBtn" type="Button" parent="Margin/VBox"]
text = "Close [I]"

[connection signal="pressed" from="Margin/VBox/CloseBtn" to="." method="_on_close_btn_pressed"]
